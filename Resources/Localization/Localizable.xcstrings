      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockling can check for a new version once a day and let you know in the menu bar item when one is out. Updates are never installed automatically.\n\nIt only asks GitHub for the latest version number and sends nothing else. You can change this in Settings."
          }
