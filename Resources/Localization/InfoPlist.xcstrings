    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockling uses your location for the Weather widget."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会使用你的位置来显示天气小组件。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会使用你的位置来显示天气小组件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会使用你的位置来显示天气小组件。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockling uses the microphone to record voice memos when you press the Recorder widget's button. Recordings are saved only in the folder you choose. It also uses it to show the input level when you tap Test level in the Microphone panel; nothing is recorded or kept."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会在你按下“录音”小组件的按钮时使用麦克风录制语音备忘录，录音只保存在你选择的文件夹中。在麦克风面板里点「测电平」时也会用麦克风显示输入电平，不录下也不保存。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会在你按下“录音”小组件的按钮时使用麦克风录制语音备忘录，录音只保存在你选择的文件夹中。在麦克风面板里点「测电平」时也会用麦克风显示输入电平，不录下也不保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会在你按下“录音”小组件的按钮时使用麦克风录制语音备忘录，录音只保存在你选择的文件夹中。在麦克风面板里点「测电平」时也会用麦克风显示输入电平，不录下也不保存。"
          }
        }
      }
    },
    "NSNetworkVolumesUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockling reads the folder on a network volume you chose for Photo Frame to show its pictures."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会读取你为“相册”选择的网络卷宗上的文件夹，以显示其中的图片。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会读取你为“相册”选择的网络卷宗上的文件夹，以显示其中的图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会读取你为“相册”选择的网络卷宗上的文件夹，以显示其中的图片。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The wide Photo Frame card shows photos taken on this day in earlier years, with their date and place. Dockling only reads them to show on the card."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宽幅相册卡片会显示往年今天拍的照片，以及拍摄日期和地点。码头只读取照片用来显示在卡片上。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宽幅相册卡片会显示往年今天拍的照片，以及拍摄日期和地点。码头只读取照片用来显示在卡片上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "宽幅相册卡片会显示往年今天拍的照片，以及拍摄日期和地点。码头只读取照片用来显示在卡片上。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockling shows your reminders in shelf widgets and can mark them as done."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会在程序坞小组件中显示你的提醒事项，并可将其标记为已完成。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会在程序坞小组件中显示你的提醒事项，并可将其标记为已完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会在程序坞小组件中显示你的提醒事项，并可将其标记为已完成。"
          }
        }
      }
    },
    "NSRemovableVolumesUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockling reads the folder on an external disk you chose for Photo Frame to show its pictures."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会读取你为“相册”选择的外置磁盘上的文件夹，以显示其中的图片。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会读取你为“相册”选择的外置磁盘上的文件夹，以显示其中的图片。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会读取你为“相册”选择的外置磁盘上的文件夹，以显示其中的图片。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockling uses on-device speech recognition to turn your Recorder memos into text. Audio never leaves your Mac."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会在本机用系统语音识别把“录音”小组件的录音转成文字，声音不会离开你的 Mac。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会在本机用系统语音识别把“录音”小组件的录音转成文字，声音不会离开你的 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头会在本机用系统语音识别把“录音”小组件的录音转成文字，声音不会离开你的 Mac。"
          }
        }
      }
    }
  },
  "version" : "1.0"
