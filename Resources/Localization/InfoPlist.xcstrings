          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockling"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "码头"
          }
        },
        "zh-Hant" : {
