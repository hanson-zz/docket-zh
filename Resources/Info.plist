<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>zh-Hans</string>
	<key>CFBundleLocalizations</key><array><string>zh-Hans</string><string>en</string></array>
	<key>CFBundleDisplayName</key><string>码头</string>
	<key>LSHasLocalizedDisplayName</key><true/>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSUIElement</key><true/>
	<key>NSHumanReadableCopyright</key><string>原作 © 2026 Naman Parashar（MIT）。码头新增部分 © 2026 Hanson，保留所有权利。</string>
	<key>DocklingUpdateRepository</key><string>$(DOCKLING_UPDATE_REPOSITORY)</string>
	<key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoadsForMedia</key><true/></dict>
	<key>NSCalendarsFullAccessUsageDescription</key><string>码头会在程序坞小组件中显示你即将到来的日程。</string>
	<key>NSRemindersFullAccessUsageDescription</key><string>码头会在程序坞小组件中显示你的提醒事项，并可将其标记为已完成。</string>
	<key>NSAppleEventsUsageDescription</key><string>码头通过程序坞小组件控制音乐播放，读取浏览器标签页中正在播放的媒体，在“邮件”小组件中读取“邮件”App 收件箱的未读数量，并通过访达清空废纸篓、推出磁盘。</string>
	<key>NSLocationWhenInUseUsageDescription</key><string>码头会使用你的位置来显示天气小组件。</string>
	<key>NSDesktopFolderUsageDescription</key><string>码头会读取“桌面”文件夹，在“最近截图”小组件中显示你的截图。</string>
	<key>NSDownloadsFolderUsageDescription</key><string>码头会读取“下载”文件夹，在“下载”小组件中显示最近下载的文件。</string>
	<key>NSDocumentsFolderUsageDescription</key><string>码头会读取你为“相册”或截图选择的“文稿”中的文件夹，以显示其中的图片。</string>
	<key>NSRemovableVolumesUsageDescription</key><string>码头会读取你为“相册”选择的外置磁盘上的文件夹，以显示其中的图片。</string>
	<key>NSNetworkVolumesUsageDescription</key><string>码头会读取你为“相册”选择的网络卷宗上的文件夹，以显示其中的图片。</string>
	<key>NSAudioCaptureUsageDescription</key><string>码头会在你调节“应用音量”小组件中某个应用的音量或将其静音时，接入该应用的声音并按你设置的音量重新播放。声音不会被录制或保存。</string>
	<key>NSCameraUsageDescription</key><string>码头会在你点“快速开关”里的“镜子”时打开摄像头，在小窗里显示画面方便照一照。画面不会被录制或保存，关掉小窗就停止使用摄像头。</string>
	<key>NSMicrophoneUsageDescription</key><string>码头会在你按下“录音”小组件的按钮时使用麦克风录制语音备忘录，录音只保存在你选择的文件夹中。</string>
</dict>
</plist>
