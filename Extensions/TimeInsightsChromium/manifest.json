{
  "manifest_version": 3,
  "name": "Dockling Time Insights",
  "version": "0.1.0",
  "description": "Shares eligible foreground website domains with Dockling on this Mac.",
  "background": { "service_worker": "worker.js" },
  "minimum_chrome_version": "105",
  "incognito": "spanning",
  "permissions": ["nativeMessaging", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
